{
    "name": "chrisabner/cordon-modulith",
    "description": "Cordon off your modules: verifiable boundaries between modules in Laravel applications.",
    "keywords": ["laravel", "modules", "modular-monolith", "modulith", "architecture", "static-analysis", "boundaries", "module-boundaries", "dependency-cycles", "architecture-testing"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://chrisabner.github.io/Cordon-Modulith/",
    "support": {
        "issues": "https://github.com/ChrisAbner/Cordon-Modulith/issues",
        "source": "https://github.com/ChrisAbner/Cordon-Modulith",
        "docs": "https://chrisabner.github.io/Cordon-Modulith/"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nikic/php-parser": "^5.3",
        "vlucas/phpdotenv": "^5.6.1"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cordon\\": "src/"
        },
        "files": ["src/Testing/expectations.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Cordon\\Tests\\": "tests/"
        },
        "classmap": ["tests/Fixtures/namespace-app/app"]
    },
    "bin": ["bin/cordon"],
    "extra": {
        "phpstan": {
            "includes": ["extension.neon"]
        },
        "laravel": {
            "providers": [
                "Cordon\\Laravel\\CordonServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint",
        "check": ["pint --test", "phpstan analyse", "pest"],
        "bench": "php tests/Benchmark/run.php 1000 20 10",
        "coverage": "@php -d pcov.enabled=1 vendor/bin/pest --coverage --min=95",
        "mutate": "@php -d pcov.enabled=1 vendor/bin/pest --mutate --min=88",
        "oracle": ["pest --group=oracle", "php tests/Oracle/check-matrix.php"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
